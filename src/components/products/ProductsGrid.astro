---
import { url } from '@/lib/url';
import { productsPageLayout as L } from '@/data/product-layouts';
import { getProduct, productHref } from '@/data/products';
import { Txt } from './Txt';
import { placed } from './layout';
---

<div class="relative xl:[overflow-x:clip]">
  <!-- Hero (measured on the 1623px Figma frame) -->
  <section class="m-screen relative isolate flex min-h-[260px] items-center justify-center overflow-hidden bg-navy px-6 py-16 text-center md:min-h-[340px] xl:block xl:h-[636px] xl:p-0">
    <img
      src={url(L.hero.src)}
      alt=""
      width={L.hero.w}
      height={L.hero.h}
      class="absolute inset-0 -z-10 h-full w-full object-cover object-right xl:inset-auto xl:z-0 xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-[max(var(--w),100%)] xl:max-w-none xl:object-fill"
      style={placed(L.hero)}
    />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-navy/45 xl:hidden"></div>
    <Txt spec={L.heroTitle} as="h1" centered className="relative text-[36px] font-bold leading-tight text-page md:text-[56px]" />
  </section>

  <!-- Catalogue: every product is centred in its own column, so images, titles and links share the same axes. -->
  <section aria-label="Products" class="px-6 py-12 md:px-10 xl:px-0 xl:pb-[160px] xl:pt-[135px] [container-type:inline-size]">
    <h2 class="m-0 mb-10 text-center text-[26px] font-bold leading-tight text-black md:text-[34px] xl:mb-[96px] xl:text-[38px] xl:leading-[42px]">
      {L.heading.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}
    </h2>
    <ul class="mx-auto m-0 flex max-w-[1180px] list-none flex-wrap justify-center gap-6 p-0 xl:max-w-[clamp(1100px,72cqw,1560px)] xl:gap-10">
      {
        L.items.map((item) => {
          const product = getProduct(item.slug);
          return (
            <li class="flex w-full sm:w-[calc((100%-24px)/2)] lg:w-[calc((100%-48px)/3)] xl:w-[calc((100%-80px)/3)]">
              <a
                href={url(productHref(item.slug))}
                class="flex w-full flex-col items-center px-6 pb-9 pt-8 text-center text-black no-underline transition-[scale] duration-300 ease-out hover:scale-[1.05] focus-visible:scale-[1.05] motion-reduce:transition-none motion-reduce:hover:scale-100"
              >
                <span class="flex h-[240px] w-full items-center justify-center xl:h-[clamp(330px,25cqw,500px)]">
                  <img
                    src={url(item.image.src)}
                    alt={product.nameLines.join(' ')}
                    width={item.image.w}
                    height={item.image.h}
                    class="h-full w-auto max-w-[92%] object-contain"
                  />
                </span>
                <h3 class="m-0 mt-6 text-[22px] font-bold leading-[1.15] xl:text-[clamp(22px,1.7cqw,30px)]">
                  {item.title.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}
                </h3>
                <span class="mt-4 inline-flex items-center gap-2 whitespace-nowrap text-[15px] font-medium text-navy">
                  Learn more
                  <img src={url('/assets/shared/arrow-right.png')} alt="" width="17" height="17" class="h-[17px] w-[17px]" />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</div>
