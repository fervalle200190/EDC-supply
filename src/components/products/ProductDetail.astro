---
import { url } from '@/lib/url';
import { productPageLayouts } from '@/data/product-layouts';
import { cardTemplates } from '@/data/carousel-templates';
import { products } from '@/data/products';
import { Txt } from './Txt';
import { RelatedCarousel } from './RelatedCarousel';
import { STAGE_TOP, placed } from './layout';
import { showcaseTrim } from '@/data/showcase-trim';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const L = productPageLayouts[slug];
if (!L) throw new Error(`No layout for product: ${slug}`);
const { hero } = L;

// Desktop: the hero keeps the design's coordinates, the features get a full-viewport section of their own, and the
// showcase + "Keep exploring" block (still measured on the frame) is re-based so it starts right under that section.
const heroBottom = hero.photo.y + hero.photo.h;
const featuresBottom = Math.max(...L.features.map((f) => f.description.top + f.description.lines.length * f.description.lh));
const restTop = Math.round(featuresBottom + 60);

// The hero's overlay, gradient and squiggles are drawn a few px taller than the photo in the design; they must never
// spill outside it (a strip of gradient showed above/below the picture). Overlays take the photo's box, the lines are clipped.
const photoBox = { y: hero.photo.y, h: hero.photo.h };
const LINES = { w: 248.33, h: 696.81 };
const linesClip = hero.lines
  ? `inset(${Math.max(0, hero.photo.y - hero.lines.y)}px 0 ${Math.max(0, hero.lines.y + LINES.h - heroBottom)}px 0)`
  : undefined;

// Phones: pictures stack top-to-bottom in their left-to-right order, cropped to the product (no transparent padding),
// full width but never taller than ~60% of the screen.
const showcase = [...L.showcase].sort((a, b) => a.x - b.x).map((img) => {
  const t = showcaseTrim[img.src];
  if (!t) return { img, wrap: {}, crop: {} };
  return {
    img,
    wrap: { aspectRatio: `${t.w} / ${t.h}`, maxWidth: `calc(60svh * ${(t.w / t.h).toFixed(4)})` },
    crop: {
      '--mw': `${((t.width / t.w) * 100).toFixed(3)}%`,
      '--ml': `${((-t.x / t.w) * 100).toFixed(3)}%`,
      '--mt': `${((-t.y / t.h) * 100).toFixed(3)}%`,
    },
  };
});

// Only the templates the carousel can need (every product except this one).
const templates = Object.fromEntries(products.filter((p) => p.slug !== slug).map((p) => [p.slug, cardTemplates[p.slug]]));

/** Absolute box on desktop (`xl:`); small screens let the element flow. */
const abs = 'xl:absolute stage-x xl:top-(--y) xl:h-(--h) xl:w-(--w) xl:max-h-none xl:max-w-none';
/** Product pictures: grow with the monitor (--img-k, set by BaseLayout) and a little more under the pointer. */
const zoomable = 'transition-transform duration-300 ease-out hover:scale-[1.05] motion-reduce:transition-none motion-reduce:hover:scale-100 xl:[transform:scale(var(--img-k,1))]';
/** Full-bleed backgrounds: start at the screen edge and stretch to its right edge when wider than the frame. */
const bleed = 'xl:absolute xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-[max(var(--w),100%)] xl:max-h-none xl:max-w-none';
---

<div class="relative xl:[overflow-x:clip]" style={{ '--hh': `${heroBottom - STAGE_TOP}px`, '--h': `${L.footerTop - STAGE_TOP}px`, '--ctop': `${STAGE_TOP - restTop}px`, '--ch': `${L.footerTop - restTop}px` }}>
  <!-- Hero -->
  <section class="m-screen relative isolate flex flex-col items-center gap-6 overflow-hidden bg-navy px-6 py-16 text-center md:px-10 md:py-24 xl:contents">
    {
      hero.photo.crop ? (
        <div class="absolute inset-0 -z-20 overflow-hidden xl:inset-auto xl:z-0 xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-[calc(max(var(--w),100%)+24px)]" style={placed(hero.photo)}>
          <img src={url(hero.photo.src)} alt="" class="absolute left-0 max-w-none object-fill" style={{ top: `${hero.photo.crop.y}px`, width: `max(${hero.photo.crop.w}px, 100%)`, height: 'auto', aspectRatio: `${hero.photo.crop.w} / ${hero.photo.crop.h}` }} />
        </div>
      ) : (
        <img
          src={url(hero.photo.src)}
          alt=""
          width={hero.photo.w}
          height={hero.photo.h}
          class="absolute inset-0 -z-20 h-full w-full object-cover xl:inset-auto xl:z-0 xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-[calc(max(var(--w),100%)+24px)] xl:max-w-none xl:object-fill"
          style={placed(hero.photo)}
        />
      )
    }
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-navy/65 xl:hidden"></div>
    {hero.overlay && <img src={url(hero.overlay.src)} alt="" aria-hidden="true" class={`hidden xl:block ${bleed} xl:object-fill`} style={placed({ ...hero.overlay, ...photoBox })} />}
    {hero.cssGradient && <div aria-hidden="true" class={`hidden xl:block ${bleed}`} style={{ ...placed({ ...hero.cssGradient, ...photoBox }), background: hero.cssGradient.background }}></div>}
    {hero.lines && <img src={url('/assets/products/hero-lines.svg')} alt="" aria-hidden="true" class={`hidden xl:block xl:absolute xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-(--w) xl:max-w-none`} style={{ ...placed({ ...hero.lines, ...LINES }), clipPath: linesClip }} />}

    <Txt spec={L.title} as="h1" centered className="relative text-[34px] font-bold leading-[1.1] text-page md:text-[48px]" />
    <Txt spec={L.subtitle} centered className="relative max-w-[560px] text-[18px] font-medium leading-[1.4] text-page md:text-[20px]" />
    <a
      href={url('/contact')}
      class="cta relative mt-2 inline-flex h-[54px] w-[298px] items-center justify-center rounded-full bg-[#a9d3c5] text-[20px] font-semibold text-navy no-underline xl:absolute stage-x xl:top-(--y) xl:mt-0 xl:h-(--h) xl:w-(--w)"
      style={placed(L.button)}
    >
      Request a quote
    </a>
  </section>

  <div aria-hidden="true" class="hidden xl:block xl:h-(--hh)"></div>

  <!-- Features: a section of its own that fills the viewport height, content centred on both axes -->
  <section aria-label="Key features" class="grid gap-12 px-6 py-12 md:grid-cols-3 md:px-10 xl:flex xl:min-h-[calc(90svh/var(--site-zoom,1))] xl:items-center xl:justify-center xl:px-0 xl:py-16 [container-type:inline-size]">
    <div class="contents xl:grid xl:w-[min(1320px,86cqw)] xl:grid-cols-3 xl:items-start xl:gap-[clamp(40px,5cqw,110px)]">
      {
        L.features.map((f) => (
          <article class="flex flex-col items-center text-center">
            <img src={url(f.icon.src)} alt="" width={f.icon.w} height={f.icon.h} class="h-24 w-24 object-contain xl:h-[clamp(130px,11cqw,210px)] xl:w-[clamp(130px,11cqw,210px)]" />
            <h2 class="m-0 mt-5 text-[20px] font-semibold leading-tight text-black xl:mt-[clamp(28px,2.6cqw,48px)] xl:text-[clamp(20px,1.55cqw,28px)]">{f.heading.lines.join(' ')}</h2>
            <p class="m-0 mt-3 max-w-[420px] text-[18px] font-normal leading-[1.35] text-black xl:mt-[clamp(14px,1.4cqw,26px)] xl:max-w-[clamp(300px,25cqw,470px)] xl:text-[clamp(18px,1.35cqw,25px)]">{f.description.lines.join(' ')}</p>
          </article>
        ))
      }
    </div>
  </section>

  <div class="contents xl:relative xl:block xl:h-(--ch)">
  <div class="contents xl:absolute xl:inset-x-0 xl:top-(--ctop) xl:block xl:h-(--h)">

  <!-- Product showcase -->
  <section aria-label="Product range" class="m-screen flex flex-col items-center justify-center gap-10 px-6 py-12 md:px-10 xl:contents">
    {
      showcase.map(({ img, wrap, crop }) => (
        <div class="relative w-full overflow-hidden xl:contents" style={wrap}>
          <img
            src={url(img.src)}
            alt=""
            width={img.w}
            height={img.h}
            class={`max-xl:absolute max-xl:left-(--ml) max-xl:top-(--mt) max-xl:h-auto max-xl:w-(--mw) max-xl:max-w-none ${abs} ${zoomable} xl:object-fill`}
            style={{ ...placed(img), ...crop }}
          />
        </div>
      ))
    }
    {L.showcaseSvg && <img src={url(L.showcaseSvg.src)} alt="" width={L.showcaseSvg.w} height={L.showcaseSvg.h} class={`h-auto w-full max-w-[560px] ${abs} ${zoomable} xl:object-fill`} style={placed(L.showcaseSvg)} />}
  </section>

  <!-- Keep exploring -->
  <section aria-label="Keep exploring our products" class="m-screen relative isolate pt-12 xl:contents">
    <img
      src={url('/assets/products/section-gradient.png')}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 -z-10 h-full w-full object-fill xl:inset-auto xl:z-0 xl:left-(--x) xl:top-(--y) xl:h-(--h) xl:w-[max(var(--w),100%)] xl:max-w-none"
      style={placed(L.gradient)}
    />
    <Txt spec={L.explore} as="h2" style={{ '--fs': '29px' }} className="mb-8 px-6 text-[22px] font-medium leading-tight text-black md:px-10 md:text-[26px]" />
    <RelatedCarousel client:visible slug={slug} carousel={L.carousel} templates={templates} />
  </section>
  </div>
  </div>
</div>
